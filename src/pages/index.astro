---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavMenu from "../components/NavMenu.astro";
import { site } from "../data/site";
---

<BaseLayout hideHeader lockViewport>
  <section class="hero relative isolate h-full overflow-hidden">
    <img
      src="/images/hero.jpg"
      alt="A fishing boat hauls a net of silver fish from cold water with snow-covered mountains behind it."
      class="hero-photo absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />

    <div class="hero-brand">
      <h1 class="hero-logo-wrap">
        <img
          src="/images/logo-hero-trim.png"
          alt={site.name}
          class="hero-logo"
        />
      </h1>
      <div class="hero-menu">
        <NavMenu align="center" />
      </div>
    </div>

    <div class="hero-motto">
      <img src="/images/glow-strip.png" alt="" class="hero-glow" />
      <p>{site.tagline}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-photo {
    object-position: 42% 40%;
  }

  .hero-brand {
    position: absolute;
    left: 47%;
    top: 49%;
    width: min(52vw, 38rem);
    z-index: 20;
  }

  .hero-logo-wrap {
    position: absolute;
    left: 0;
    bottom: 100%;
    margin: 0;
    width: 100%;
  }

  .hero-logo {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-menu {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 0.75rem;
  }

  .hero-motto {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.35rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0 1.25rem;
    font-size: clamp(0.95rem, 2.1vw, 1.65rem);
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 28em;
    height: 2em;
    transform: translate(-50%, -50%);
    object-fit: fill;
    pointer-events: none;
    opacity: 0.45;
  }

  .hero-motto p {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--color-navy-900);
    font-family: var(--font-display);
    font-size: 1em;
    font-weight: 900;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .hero-photo {
      object-position: 38% 48%;
    }

    .hero-brand {
      left: 50%;
      top: 52%;
      width: min(92vw, 24rem);
      transform: translateX(-50%);
    }

    .hero-motto {
      bottom: 1.5rem;
    }

    .hero-glow {
      width: 28em;
      height: 2em;
    }

    .hero-motto p {
      font-size: clamp(0.72rem, 3.4vw, 1rem);
      letter-spacing: 0.02em;
    }
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    .hero-brand {
      left: 45%;
      top: 48.5%;
    }
  }
</style>

