---
import BaseLayout from "../layouts/BaseLayout.astro";
import { certifications } from "../data/certifications";
---

<BaseLayout
  title="Sustainability"
  description="Cast Right Catch sources from responsible suppliers that maintain the highest certified farms, facilities, and distributions — with chain of custody until the product reaches your door."
>
  <section class="relative isolate overflow-hidden bg-navy-950 text-white">
    <img
      src="/images/hero.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-40"
    />
    <div class="absolute inset-0 bg-navy-950/55"></div>
    <div class="relative mx-auto max-w-4xl px-5 pb-16 pt-32 text-center md:px-8 md:pt-36">
      <p class="text-sm font-semibold tracking-[0.22em] uppercase text-gold-400">Sustainability</p>
      <h1 class="mt-3 font-display text-4xl font-semibold leading-tight sm:text-5xl md:text-6xl">
        The Right <span class="block sm:inline">Direction</span>
      </h1>
      <div class="diamond-rule mx-auto mt-6 w-36 text-gold-400" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <section class="bg-cream-50" aria-labelledby="sourcing-heading">
    <div class="mx-auto max-w-4xl px-5 pt-16 md:px-8 md:pt-24">
      <p class="text-sm font-semibold tracking-[0.22em] uppercase text-gold-600">Responsible sourcing</p>
      <h2
        id="sourcing-heading"
        class="mt-3 font-display text-3xl font-semibold text-balance text-navy-800 sm:text-4xl md:text-5xl"
      >
        Certified from the source to your door.
      </h2>
      <div class="diamond-rule mt-6 w-28 text-gold-500" aria-hidden="true"><span></span></div>
      <div class="mt-8 space-y-5 text-lg leading-relaxed text-navy-800/85">
        <p>
          Cast Right Catch sources from responsible suppliers that maintain the highest certified farms, facilities, and distributions. We can maintain this chain of custody until the product reaches your door.
        </p>
        <p>
          A few of the certifications and sustainable options we will maintain through delivery are mentioned below.
        </p>
      </div>
    </div>

    <div class="mx-auto w-full min-w-0 max-w-6xl px-5 pt-12 pb-16 md:px-8 md:pt-16 md:pb-24">
      <ul class="grid min-w-0 gap-5 sm:grid-cols-2 lg:grid-cols-3" aria-label="Certifications">
        {
          certifications.map((cert) => (
            <li class="flex min-w-0 flex-col rounded-2xl border border-cream-200 bg-white p-6 shadow-sm">
              <div class="flex h-36 w-full min-w-0 items-center justify-center overflow-hidden px-2">
                <img
                  src={cert.image.src}
                  alt={cert.image.alt}
                  width={cert.image.width}
                  height={cert.image.height}
                  class="max-h-full w-auto max-w-full object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <p class="mt-5 text-center font-display text-2xl font-semibold text-navy-800">{cert.name}</p>
              <p class="mt-1 text-center text-sm tracking-[0.04em] text-navy-800/70">{cert.fullName}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-navy-900 text-white">
    <div class="mx-auto max-w-3xl px-5 py-16 text-center md:px-8 md:py-24">
      <h2 class="font-display text-3xl font-semibold text-balance md:text-5xl">Let’s talk about the catch</h2>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/85">
        If you care about how seafood is sourced and how it gets there, we would like to hear from you.
      </p>
      <a href="/contact" class="btn-gold mt-10">Contact Us</a>
    </div>
  </section>
</BaseLayout>
