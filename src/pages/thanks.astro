---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="Thank You" description="Your message has been sent to Cast Right Catch Co.">
  <section class="flex min-h-[70vh] items-center bg-cream-50 px-5 pt-32 pb-16">
    <div class="mx-auto max-w-xl rounded-2xl bg-white p-10 text-center shadow-sm">
      <p class="text-sm font-semibold tracking-[0.22em] uppercase text-gold-600">Message sent</p>
      <h1 class="mt-3 font-display text-4xl font-semibold text-navy-800">Thank you</h1>
      <p class="mt-4 text-lg leading-relaxed text-navy-800/80">
        We received your note and will get back to you shortly.
      </p>
      <p class="mt-3 text-navy-800/70">
        Need us sooner? Email <a class="underline decoration-gold-500 underline-offset-2" href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
      <a href="/" class="btn-gold mt-8">Back to Home</a>
    </div>
  </section>
</BaseLayout>
