---
import BaseLayout from "../layouts/BaseLayout.astro";
import { services } from "../data/services";
---

<BaseLayout
  title="Services"
  description="Fresh and frozen sourcing, supply management, long-term commitments, market communication, logistics, and accounting from Cast Right Catch Co."
>
  <section class="relative isolate overflow-hidden bg-navy-950 text-white">
    <img
      src="/images/hero.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-40"
    />
    <div class="absolute inset-0 bg-navy-950/55"></div>
    <div class="relative mx-auto max-w-4xl px-5 pb-16 pt-32 text-center md:px-8 md:pt-36">
      <p class="text-sm font-semibold tracking-[0.22em] uppercase text-gold-400">Services</p>
      <h1 class="mt-3 font-display text-4xl font-semibold leading-tight sm:text-5xl md:text-6xl">
        The Harvest <span class="block sm:inline">to Your Door</span>
      </h1>
      <div class="diamond-rule mx-auto mt-6 w-36 text-gold-400" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-5 py-16 md:px-8 md:py-20">
      <p class="text-sm font-semibold tracking-[0.22em] uppercase text-gold-600">How we work</p>
      <h2 class="mt-3 font-display text-3xl font-semibold text-navy-800 text-balance sm:text-4xl md:text-5xl">
        We will bring the Harvest to your door.
      </h2>
      <nav class="mt-10 flex w-full min-w-0 flex-wrap gap-2" aria-label="Service list">
        {
          services.map((service) => (
            <a
              href={`#${service.id}`}
              class="shrink-0 rounded-full border border-cream-200 px-3 py-2 text-sm font-semibold text-navy-800 transition-colors hover:border-gold-500 hover:text-navy-600 sm:px-4"
            >
              {service.shortName}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    services.map((service, index) => (
      <section
        id={service.id}
        class:list={[index % 2 === 0 ? "bg-cream-50" : "bg-white", "scroll-mt-28"]}
      >
        <div class="mx-auto max-w-4xl px-5 py-16 md:px-8 md:py-20">
          <p class="text-sm font-semibold tracking-[0.22em] uppercase text-gold-600">{service.kicker}</p>
          <h2 class="mt-3 font-display text-3xl font-semibold leading-tight text-navy-800 sm:text-4xl md:text-5xl">
            {
              service.mobileName ? (
                <>
                  {service.mobileName[0]}{" "}
                  <span class="block sm:inline">{service.mobileName[1]}</span>
                </>
              ) : (
                service.name
              )
            }
          </h2>
          <div class="diamond-rule mt-6 w-28 text-gold-500" aria-hidden="true"><span></span></div>
          <div class="mt-8 space-y-5 text-lg leading-relaxed text-navy-800/85">
            {service.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="bg-navy-900 text-white">
    <div class="mx-auto max-w-3xl px-5 py-16 text-center md:px-8 md:py-24">
      <h2 class="font-display text-3xl font-semibold text-balance md:text-5xl">Ready to work together?</h2>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/85">
        Tell us what you need. Our team will get back to you shortly.
      </p>
      <a href="/contact" class="btn-gold mt-10">Contact Us</a>
    </div>
  </section>
</BaseLayout>
