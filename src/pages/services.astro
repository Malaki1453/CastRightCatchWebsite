---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Services"
  description="Cast Right Catch Co. helps seafood buyers move product with trusted partnerships and simpler logistics."
>
  <section class="relative isolate overflow-hidden bg-navy-950 text-white">
    <img
      src="/images/hero.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-40"
    />
    <div class="absolute inset-0 bg-navy-950/55"></div>
    <div class="relative mx-auto max-w-4xl px-5 pb-16 pt-32 text-center md:px-8 md:pt-36">
      <p class="text-sm font-semibold tracking-[0.22em] uppercase text-gold-400">Services</p>
      <h1 class="mt-3 font-display text-5xl font-semibold md:text-6xl">Partnerships That Move</h1>
      <div class="diamond-rule mx-auto mt-6 w-36 text-gold-400" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-5 py-16 md:px-8 md:py-24">
      <p class="text-sm font-semibold tracking-[0.22em] uppercase text-gold-600">How we work</p>
      <h2 class="mt-3 font-display text-4xl font-semibold text-navy-800 md:text-5xl">
        Trusted partnerships and simpler logistics.
      </h2>
      <div class="mt-8 space-y-5 text-lg leading-relaxed text-navy-800/85">
        <p>
          We partner with seafood buyers who need a reliable path from producer to plate. That means matching the right catch, keeping quality intact, and taking friction out of the supply chain.
        </p>
        <p>
          From sourcing through delivery, we stay close to the details so our customers can focus on their business — with honesty, wisdom, and commitment at every step.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-navy-900 text-white">
    <div class="mx-auto max-w-3xl px-5 py-16 text-center md:px-8 md:py-24">
      <h2 class="font-display text-4xl font-semibold md:text-5xl">Ready to work together?</h2>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/85">
        Tell us what you need. Our team will get back to you shortly.
      </p>
      <a href="/contact" class="btn-gold mt-10">Contact Us</a>
    </div>
  </section>
</BaseLayout>
