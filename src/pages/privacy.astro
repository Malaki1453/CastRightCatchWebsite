---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Privacy Policy"
  description="How Cast Right Catch Co. collects and uses information submitted through this website."
>
  <section class="bg-navy-950 pt-32 pb-14 text-white md:pt-36">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <h1 class="font-display text-5xl font-semibold">Privacy Policy</h1>
      <p class="mt-3 text-white/70">Last updated August 2026</p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-3xl space-y-6 px-5 py-14 leading-relaxed text-navy-800/90 md:px-8">
      <p>
        {site.name} respects your privacy. This page explains what we collect when you use castrightcatch.com and how we use it.
      </p>
      <h2 class="font-display text-3xl font-semibold text-navy-900">Information we collect</h2>
      <p>
        If you submit the contact form, we receive the details you provide — such as name, email, phone number, company name, and your message.
      </p>
      <h2 class="font-display text-3xl font-semibold text-navy-900">How we use it</h2>
      <p>
        We use that information to respond to inquiries, follow up on wholesale opportunities, and, if you consent, send occasional updates related to our products and services. We do not sell your information.
      </p>
      <h2 class="font-display text-3xl font-semibold text-navy-900">Contact</h2>
      <p>
        Questions about this policy can be sent to
        <a class="underline decoration-gold-500 underline-offset-2" href={`mailto:${site.email}`}>{site.email}</a>
        or mailed to {site.addressLines.join(", ")}.
      </p>
    </div>
  </section>
</BaseLayout>
