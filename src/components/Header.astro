---
import { site } from "../data/site";
import NavMenu from "./NavMenu.astro";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header
  id="site-header"
  data-transparent={transparent ? "true" : "false"}
  class:list={[
    "fixed inset-x-0 top-0 z-50 transition-colors duration-300",
    transparent ? "text-white" : "bg-navy-950 text-white shadow-sm",
  ]}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 md:px-8">
    <a href="/" class="flex min-w-0 items-center gap-3" aria-label={`${site.name} home`}>
      <img
        src="/images/seal.png"
        alt=""
        class="h-11 w-11 shrink-0 object-contain md:h-12 md:w-12"
      />
      <span class="hidden flex-col leading-none sm:flex">
        <span class="font-display text-lg font-semibold tracking-[0.18em] md:text-xl">CAST RIGHT</span>
        <span class="mt-1 flex items-center gap-2 text-sm">
          <span class="h-px w-5 bg-gold-500"></span>
          <span class="font-display italic tracking-wide">Catch Co.</span>
          <span class="h-px w-5 bg-gold-500"></span>
        </span>
      </span>
    </a>

    <NavMenu />
  </div>
</header>

<script>
  const header = document.getElementById("site-header");

  const onScroll = () => {
    if (!header || header.dataset.transparent !== "true") return;
    header.classList.toggle("is-scrolled", window.scrollY > 16);
  };

  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  #site-header[data-transparent="true"] {
    background: transparent;
  }

  #site-header[data-transparent="true"].is-scrolled,
  #site-header[data-transparent="true"]:has(#site-menu:not(.hidden)) {
    background: rgb(7 18 33 / 0.92);
    backdrop-filter: blur(10px);
  }
</style>
